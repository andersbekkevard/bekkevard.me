---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import dayjs from "dayjs";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  showImage?: boolean;
  size?: "lead" | "standard" | "compact";
}

const {
  variant = "h2",
  data,
  id,
  filePath,
  body,
  showImage = true,
  size = "standard",
} = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, heroImage, tags } = data;
const readingTime = calculateReadingTime(body ?? "");
const date = dayjs(pubDatetime).format("D MMMM YYYY");
const primaryTag = tags?.[0];
---

<article class:list={[
  "newspaper-card group",
  {
    "newspaper-card--lead": size === "lead",
    "newspaper-card--compact": size === "compact",
  },
]}>
  {primaryTag && (
    <span class="section-label mb-1 block">{primaryTag}</span>
  )}

  <a
    href={getPath(id, filePath)}
    class="block"
  >
    {
      variant === "h2" ? (
        <h2
          style={{ viewTransitionName: slugifyStr(title) }}
          class:list={[
            "font-headline text-foreground hover:text-accent transition-colors duration-150",
            size === "lead" ? "text-2xl sm:text-3xl md:text-4xl" : size === "compact" ? "text-base sm:text-lg" : "text-xl sm:text-2xl",
          ]}
        >
          {title}
        </h2>
      ) : (
        <h3
          style={{ viewTransitionName: slugifyStr(title) }}
          class:list={[
            "font-headline text-foreground hover:text-accent transition-colors duration-150",
            size === "lead" ? "text-2xl sm:text-3xl md:text-4xl" : size === "compact" ? "text-base sm:text-lg" : "text-xl sm:text-2xl",
          ]}
        >
          {title}
        </h3>
      )
    }
  </a>

  {size !== "compact" && (
    <p class:list={[
      "font-serif text-foreground/80 mt-2",
      size === "lead" ? "text-lg italic leading-relaxed" : "text-base leading-relaxed",
    ]}>
      {description}
    </p>
  )}

  <div class="mt-2 flex items-center gap-2 font-sans-ui text-xs text-meta uppercase tracking-wide">
    <time datetime={dayjs(pubDatetime).toISOString()}>{date}</time>
    {readingTime && (
      <>
        <span class="text-border">·</span>
        <span>{readingTime}</span>
      </>
    )}
  </div>
</article>
