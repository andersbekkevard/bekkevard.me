---
import Socials from "./Socials.astro";
import { SITE } from "@/config";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
const sourceRepo = SITE.editPost.url.replace(/\/edit\/main\/?$/, "");
---

<footer class:list={["w-full mx-auto max-w-4xl px-4", { "mt-auto": !noMarginTop }]}>
  <div class="rule-double"></div>
  <div class="py-6 flex flex-col items-center gap-3">
    <div class="flex items-center gap-4">
      <Socials centered />
    </div>
    <p class="font-sans-ui text-xs text-meta text-center tracking-wide">
      <a href={sourceRepo} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Source available
      </a>
      &nbsp;·&nbsp; Content CC BY 4.0 &nbsp;·&nbsp; Code MIT
    </p>
  </div>
</footer>
