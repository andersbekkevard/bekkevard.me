---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter((p) => p.trim());
  const pathArray = path.split("/").filter((p) => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const today = new Date();
const dateStr = today.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<header class="w-full">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute -top-full left-16 z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>

  <!-- Top thin rule -->
  <div class="rule-accent"></div>

  <!-- Masthead -->
  <div class="mx-auto max-w-4xl px-4">
    <div class="py-6 text-center sm:py-8">
      <a href="/" class="group inline-block">
        <h1 class="font-headline text-3xl tracking-tight text-foreground sm:text-5xl md:text-6xl uppercase">
          {SITE.title}
        </h1>
      </a>
      <p class="mt-1 text-sm text-meta font-sans-ui tracking-wide">
        {dateStr}
      </p>
    </div>
  </div>

  <!-- Navigation rule -->
  <div class="mx-auto max-w-4xl px-4 rule-thick"></div>

  <!-- Navigation bar -->
  <div class="mx-auto max-w-4xl px-4">
    <nav id="nav-menu" class="relative flex items-center justify-center py-3">
      <!-- Mobile menu button -->
      <button
        id="menu-btn"
        class="focus-outline absolute left-0 grid size-11 place-items-center rounded-sm sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <!-- Desktop nav links -->
      <ul
        id="menu-items"
        class:list={[
          "absolute top-full left-0 z-40 mt-1 w-full border border-border bg-background p-3 shadow-sm",
          "hidden",
          "sm:static sm:mt-0 sm:flex sm:w-auto sm:items-center sm:gap-x-8 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none",
        ]}
      >
        <li>
          <a
            href="/posts"
            class:list={[
              "block py-3 text-center font-sans-ui text-sm font-semibold uppercase tracking-widest text-foreground hover:text-accent sm:py-0",
              { "active-nav": isActive("/posts") },
            ]}
          >
            Essays
          </a>
        </li>
        <li>
          <a
            href="/about"
            class:list={[
              "block py-3 text-center font-sans-ui text-sm font-semibold uppercase tracking-widest text-foreground hover:text-accent sm:py-0",
              { "active-nav": isActive("/about") },
            ]}
          >
            About
          </a>
        </li>
        <li class="flex items-center justify-center py-3 sm:py-0">
          <a
            href="/search"
            class:list={[
              "font-sans-ui text-sm font-semibold uppercase tracking-widest text-foreground hover:text-accent inline-flex items-center gap-1",
              { "active-nav": isActive("/search") },
            ]}
            aria-label="Search"
          >
            <IconSearch class="size-4" />
            <span class="sm:sr-only">Search</span>
          </a>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="flex items-center justify-center py-3 sm:py-0">
              <button
                id="theme-btn"
                class="focus-outline relative size-8 hover:[&>svg]:stroke-accent"
                title="Toggle theme"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>

      <!-- RSS link on the right -->
      <a
        href="/rss.xml"
        class="absolute right-0 font-sans-ui text-xs font-medium uppercase tracking-widest text-meta hover:text-accent"
        title="RSS Feed"
      >
        RSS
      </a>
    </nav>
  </div>

  <!-- Bottom rule -->
  <div class="mx-auto max-w-4xl px-4 rule-thin"></div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    const navLinks = document.querySelectorAll("#menu-items a");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;
    if (menuBtn.getAttribute("data-nav-init") === "true") return;
    menuBtn.setAttribute("data-nav-init", "true");

    const setMenuState = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      menuBtn.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
      menuItems.classList.toggle("hidden", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      setMenuState(!openMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuState(false);
      }
    });

    navLinks.forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", () => {
    toggleNav();
  });
</script>
